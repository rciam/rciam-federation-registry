EXPRESS_BASE = http://localhost:5000
AMS_AGENT_KEY=banana
REDIRECT_URI=http://localhost:5000/callback/
AMS_AUTH_KEY=banana
AMS_VER_HASH=banana
ADMIN_AUTH_KEY=banana
CORS=http://localhost:3000
# Comma-separated list of URL patterns to exclude from request logging (e.g., monitoring endpoints)
LOG_IGNORE_PATTERNS=

# Logging configuration: 'file', 'console', or 'both' (default)
LOG_DESTINATIONS=both

# Express trust proxy setting used to derive the client IP in access logs
EXPRESS_TRUST_PROXY=false
